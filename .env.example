# PayPal Sandbox REST API Credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Channel3 Product Graph (Optional - Fallbacks available)
CHANNEL3_API_KEY=your_channel3_api_key
CHANNEL3_API_BASE=https://api.trychannel3.com/v1

# Zapier Webhook (Optional - Lifecycle broadcast)
ZAPIER_WEBHOOK_URL=your_zapier_webhook_url

# Independent Web Search API (Optional - Secondary fallback for Price Intelligence Engine)
SEARCH_API_KEY=your_search_api_key_or_brave_key
SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search

